PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shortlink
BASE_URL=http://localhost:3000
DB_SSL=false

# Rate limiting (per-IP, in-memory)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_REDIRECT_MAX=240
RATE_LIMIT_API_MAX=300

# Analytics
ANALYTICS_MAX_DAYS=90

# CORS: comma-separated origins allowed to call the API from a browser.
# Leave empty for same-origin only (the Vite dev proxy needs nothing here).
# CORS_ORIGIN=https://shortlink.example.com
